; Driver de LED WS2812 (RGB enderecavel) para o LED da RP2040-Zero (GP16).
; Mesma temporizacao padrao usada nos exemplos oficiais do pico-sdk
; (T1=2, T2=5, T3=3 ciclos por bit), licenca BSD-3-Clause.

.program ws2812
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
do_one:
    jmp bitloop    side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap
